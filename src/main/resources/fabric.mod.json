{
  "schemaVersion": 1,
  "id": "dds-tweak",
  "version": "${version}",
  "name": "DDS Tweak",
  "description": "Client-side tweaks and the optional companion UI for Carpet DDS Addition.",
  "authors": [
    "_xoO_Oox_"
  ],
  "icon": "assets/dds-tweak/icon.png",
  "contact": {
    "sources": "https://github.com/x-oOvOo-x/DDS-Tweak"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ddstweak.DDSTweak"
    ],
    "modmenu": [
      "ddstweak.integration.modmenu.DDSTweakModMenuIntegration"
    ]
  },
  "mixins": [
    "dds-tweak.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loader_dependency}",
    "${fabric_api_mod_id}": "${fabric_api_dependency}",
    "minecraft": "${minecraft_dependency}",
    "java": "${java_dependency}",
    "malilib": "${malilib_dependency}"
  }
}
